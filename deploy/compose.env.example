# Required. Pin to the image tag loaded from the deployment package, for example
# smart-llmrouter-<version>-docker-linux-amd64 ships smart-llmrouter:<version>-linux-amd64.
SMART_LLMROUTER_VERSION=replace-with-package-version-linux-amd64

ROUTER_HOSTNAME=llm-api-engg.metrum.ai
CADDY_EMAIL=chetan@metrum.ai
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

POSTGRES_DB=llmrouter
POSTGRES_USER=llmrouter

# Required. Generate a strong random value and use the same password in
# ROUTER_USAGE_DB_DSN. Do not leave example or shared passwords in production.
# POSTGRES_PASSWORD=replace-with-strong-random-db-password
# ROUTER_USAGE_DB_DSN=host=postgres port=5432 user=llmrouter password=replace-with-same-strong-random-db-password dbname=llmrouter sslmode=disable TimeZone=UTC

# Optional. Only used when docker-compose.postgres-localhost.yml is included.
# POSTGRES_HOST_PORT=15432
