{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-api-engg.metrum.ai cutover evidence record",
  "description": "One sanitized, scalar-only observation. Raw payloads, prompts, responses, SQL, logs, credentials, secret references, configuration, and customer data are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "stage",
    "check_id",
    "observed_at",
    "outcome",
    "surface",
    "status_class",
    "latency_bucket",
    "artifact_reference",
    "observer"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "plan_id": {"$ref": "#/$defs/id"},
    "stage": {
      "enum": [
        "design-rehearsal",
        "dark-preparation",
        "write-freeze-migration",
        "limited-canary",
        "dns-tls-transition",
        "stable-observation",
        "rollback-cleanup"
      ]
    },
    "check_id": {"$ref": "#/$defs/id"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "outcome": {"enum": ["passed", "failed", "blocked", "not-run"]},
    "surface": {
      "enum": [
        "platform",
        "security",
        "health",
        "openai-chat",
        "openai-responses",
        "anthropic-messages",
        "codex-cli",
        "claude-code-cli",
        "usage",
        "quota",
        "license",
        "diagnostics",
        "reports",
        "metrics",
        "migration",
        "reconciliation",
        "dns",
        "tls",
        "rollback"
      ]
    },
    "status_class": {
      "enum": [
        "pass",
        "expected-denial",
        "http-2xx",
        "http-4xx",
        "http-5xx",
        "timeout",
        "mismatch",
        "not-applicable",
        "not-run"
      ]
    },
    "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
    "route_scope_id": {"$ref": "#/$defs/id"},
    "request_shape_bucket": {
      "enum": [
        "not-applicable",
        "small-text",
        "streaming-text",
        "tool-bearing",
        "large-tool-bearing",
        "image-bearing",
        "bridge-translated"
      ]
    },
    "selected_target_id": {"$ref": "#/$defs/id"},
    "stream_usage_present": {"type": "boolean"},
    "tool_call_shape": {
      "enum": ["not-applicable", "none", "single", "parallel", "malformed"]
    },
    "latency_bucket": {
      "enum": [
        "not-measured",
        "under-100ms",
        "100ms-499ms",
        "500ms-1999ms",
        "2s-9s",
        "10s-or-more"
      ]
    },
    "count": {"type": "integer", "minimum": 0},
    "checksum": {"$ref": "#/$defs/hash"},
    "error_class": {
      "type": "string",
      "pattern": "^(none|[a-z][a-z0-9_-]{2,63})$"
    },
    "artifact_reference": {"$ref": "#/$defs/ref"},
    "observer": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{2,199}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
