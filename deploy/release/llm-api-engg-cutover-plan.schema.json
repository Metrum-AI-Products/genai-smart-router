{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-api-engg.metrum.ai EKS cutover planning manifest",
  "description": "Secret-free planning metadata only. Validation never authorizes or performs a production, staging, cloud, DNS, database, configuration, or secret mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "plan_id",
    "change_reference",
    "dependencies",
    "source",
    "target",
    "release",
    "migration",
    "traffic",
    "dns",
    "acceptance",
    "rollback",
    "change_control",
    "gate_record",
    "evidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "authority": {"type": "string", "const": "planning_only_no_apply"},
    "plan_id": {"$ref": "#/$defs/id"},
    "change_reference": {"type": "string", "const": "#725"},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration", "production_promotion", "fleet_lifecycle"],
      "properties": {
        "migration": {"type": "string", "const": "#507"},
        "production_promotion": {"type": "string", "const": "#518"},
        "fleet_lifecycle": {"type": "string", "const": "#555"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "runtime", "authority_before_cutover", "write_freeze_required"],
      "properties": {
        "hostname": {"type": "string", "const": "llm-api-engg.metrum.ai"},
        "runtime": {"type": "string", "const": "ec2-compose"},
        "authority_before_cutover": {"type": "boolean", "const": true},
        "write_freeze_required": {"type": "boolean", "const": true}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "hostname",
        "replicas",
        "deployment_strategy",
        "state_access_mode",
        "database",
        "production_profile_authorized"
      ],
      "properties": {
        "runtime": {"type": "string", "const": "eks-fleet"},
        "hostname": {"type": "string", "const": "llm-api-engg.metrum.ai"},
        "replicas": {"type": "integer", "const": 1},
        "deployment_strategy": {"type": "string", "const": "Recreate"},
        "state_access_mode": {"type": "string", "const": "ReadWriteOnce"},
        "database": {"type": "string", "const": "private-encrypted-postgresql"},
        "production_profile_authorized": {"type": "boolean"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_digest",
        "configuration_revision",
        "configuration_fingerprint",
        "license_revision",
        "promotion_manifest_reference",
        "promotion_manifest_sha256"
      ],
      "properties": {
        "image_digest": {"$ref": "#/$defs/digest"},
        "configuration_revision": {"$ref": "#/$defs/id"},
        "configuration_fingerprint": {"$ref": "#/$defs/hash"},
        "license_revision": {"$ref": "#/$defs/id"},
        "promotion_manifest_reference": {"$ref": "#/$defs/ref"},
        "promotion_manifest_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_reference",
        "plan_sha256",
        "compatibility",
        "rollback_class",
        "logical_backup_required",
        "restore_rehearsal_required",
        "reverse_migration_allowed",
        "reprice_historical_usage"
      ],
      "properties": {
        "plan_reference": {"$ref": "#/$defs/ref"},
        "plan_sha256": {"$ref": "#/$defs/hash"},
        "compatibility": {
          "enum": ["backward-compatible", "expand-contract", "restore-required"]
        },
        "rollback_class": {
          "enum": ["package-only", "config-only", "database-restore-required"]
        },
        "logical_backup_required": {"type": "boolean", "const": true},
        "restore_rehearsal_required": {"type": "boolean", "const": true},
        "reverse_migration_allowed": {"type": "boolean", "const": false},
        "reprice_historical_usage": {"type": "boolean", "const": false}
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canary_scope_id",
        "max_canary_percent",
        "observation_minutes",
        "no_dual_writers",
        "expansion_gates_reference"
      ],
      "properties": {
        "canary_scope_id": {"$ref": "#/$defs/id"},
        "max_canary_percent": {"type": "integer", "const": 5},
        "observation_minutes": {"type": "integer", "minimum": 30, "maximum": 240},
        "no_dual_writers": {"type": "boolean", "const": true},
        "expansion_gates_reference": {"$ref": "#/$defs/ref"}
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "exact_host_only",
        "transition_plan_reference",
        "rollback_plan_reference",
        "staging_hostname_forbidden"
      ],
      "properties": {
        "hostname": {"type": "string", "const": "llm-api-engg.metrum.ai"},
        "exact_host_only": {"type": "boolean", "const": true},
        "transition_plan_reference": {"$ref": "#/$defs/ref"},
        "rollback_plan_reference": {"$ref": "#/$defs/ref"},
        "staging_hostname_forbidden": {"type": "boolean", "const": true}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_matrix_reference",
        "client_matrix_reference",
        "state_reconciliation_reference",
        "metrics_admin_isolation_required",
        "ordinary_metrics_status"
      ],
      "properties": {
        "api_matrix_reference": {"$ref": "#/$defs/ref"},
        "client_matrix_reference": {"$ref": "#/$defs/ref"},
        "state_reconciliation_reference": {"$ref": "#/$defs/ref"},
        "metrics_admin_isolation_required": {"type": "boolean", "const": true},
        "ordinary_metrics_status": {"type": "string", "const": "403 metrics-forbidden"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_minutes",
        "decision_deadline",
        "source_retained",
        "source_write_reenable_requires_restore_decision",
        "known_good_image_digest",
        "cleanup_separately_approved"
      ],
      "properties": {
        "window_minutes": {"type": "integer", "minimum": 60, "maximum": 10080},
        "decision_deadline": {"$ref": "#/$defs/timestamp"},
        "source_retained": {"type": "boolean", "const": true},
        "source_write_reenable_requires_restore_decision": {"type": "boolean", "const": true},
        "known_good_image_digest": {"$ref": "#/$defs/digest"},
        "cleanup_separately_approved": {"type": "boolean", "const": true}
      }
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_observer",
        "stop_authority",
        "evaluated_at",
        "valid_until"
      ],
      "properties": {
        "independent_observer": {"$ref": "#/$defs/id"},
        "stop_authority": {"$ref": "#/$defs/id"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"}
      }
    },
    "gate_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_stage",
        "decision",
        "decision_reference",
        "decision_sha256",
        "rollback_window_decision",
        "authority_after_decision"
      ],
      "properties": {
        "current_stage": {
          "enum": [
            "design-rehearsal",
            "dark-preparation",
            "write-freeze-migration",
            "limited-canary",
            "dns-tls-transition",
            "stable-observation",
            "rollback-cleanup"
          ]
        },
        "decision": {"enum": ["no-go", "go-review-required", "rollback"]},
        "decision_reference": {"$ref": "#/$defs/ref"},
        "decision_sha256": {"$ref": "#/$defs/hash"},
        "rollback_window_decision": {
          "enum": ["pending", "open", "closed", "rollback-invoked"]
        },
        "authority_after_decision": {"enum": ["ec2-compose", "eks-fleet"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight",
        "rehearsal",
        "api_client",
        "reconciliation",
        "dns_tls",
        "rollback"
      ],
      "properties": {
        "preflight": {"$ref": "#/$defs/evidenceRef"},
        "rehearsal": {"$ref": "#/$defs/evidenceRef"},
        "api_client": {"$ref": "#/$defs/evidenceRef"},
        "reconciliation": {"$ref": "#/$defs/evidenceRef"},
        "dns_tls": {"$ref": "#/$defs/evidenceRef"},
        "rollback": {"$ref": "#/$defs/evidenceRef"}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{2,199}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"$ref": "#/$defs/ref"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
