{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metrum-ai/router/tests/api_compat/manifest/schema.json",
  "title": "API compatibility case",
  "type": "object",
  "required": ["id", "priority", "owner", "component", "disposition", "assertions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "owner": { "type": "string" },
    "component": { "type": "string" },
    "source_url": { "type": "string" },
    "reviewed_date": { "type": "string" },
    "sdk_client_version": { "type": "string" },
    "inbound_route": { "type": "string" },
    "outbound_dialect": { "type": "string" },
    "capability_profile": { "type": "string" },
    "transport": { "type": "string", "enum": ["unary", "sse", "mixed", "n/a"] },
    "disposition": {
      "type": "string",
      "enum": [
        "native_supported",
        "supported_translation",
        "documented_normalization",
        "policy_rejection",
        "unsupported",
        "blocked"
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_id": { "type": "string" },
    "rationale": { "type": "string" }
  },
  "additionalProperties": true
}
