# Copy this file to an ignored, owner-readable environment file before use.
# Fill normal router inputs through the protected runtime environment; never
# commit endpoint values, caller keys, caller identities, or usage settings.
EVAL_BASE_URL=
EVAL_API_KEY=
EVAL_MODEL=
EVAL_MODEL_KIND=router-group
EVAL_LIMIT=8

# Ordinary bounded evaluation: no usage database input is needed.
EVAL_REQUIRE_REASONING_COVERAGE=false

# Optional reasoning coverage: set the flag above to true only in a protected
# environment, set EVAL_USAGE_CALLER_ID there, and set exactly one of the two
# protected usage configuration sources below. Keep all three blank otherwise.
EVAL_USAGE_CONFIG_YAML=
EVAL_USAGE_CONFIG_FILE=
EVAL_USAGE_CALLER_ID=
